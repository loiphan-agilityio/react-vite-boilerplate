{
  "name": "@repo/storybook-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./main": "./src/main.ts"
  },
  "scripts": {
    "lint": "oxlint -c ../../oxlint.config.ts --type-aware --deny-warnings . && prettier --check .",
    "lint:fix": "oxlint -c ../../oxlint.config.ts --type-aware --fix . && prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
