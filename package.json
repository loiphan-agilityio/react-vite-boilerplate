{
  "name": "boilerplate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "dev:mock": "turbo run dev:mock --filter=web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint lint:slop",
    "lint:fix": "turbo run lint:fix && oxlint --fix",
    "lint:slop": "oxlint",
    "test": "turbo run test",
    "build-storybook": "turbo run build-storybook",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:install": "pnpm --filter web test:e2e:install",
    "check": "turbo run lint lint:slop typecheck test && turbo run build build-storybook test:e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@oxlint/plugins": "1.78.0",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "1.78.0",
    "prettier": "catalog:",
    "turbo": "^2.11.10"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
