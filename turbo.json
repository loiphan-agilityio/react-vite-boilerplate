{
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": [".prettierrc.json"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/oxlint.config.ts", "$TURBO_ROOT$/tools/oxlint/**"]
    },
    "//#lint:root": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"],
      "env": ["VITE_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "build": {
      "dependsOn": ["transit"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "build-storybook": {
      "dependsOn": ["transit"],
      "outputs": ["storybook-static/**"],
      "env": ["VITE_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "test:e2e": {
      "dependsOn": ["transit"],
      "cache": false,
      "env": ["VITE_*"],
      "passThroughEnv": ["CI", "GITHUB_ACTIONS", "E2E_BASE_URL", "PLAYWRIGHT_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["VITE_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev:mock": {
      "cache": false,
      "persistent": true,
      "env": ["VITE_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "storybook": {
      "cache": false,
      "persistent": true,
      "env": ["VITE_*"]
    },
    "lint:fix": {
      "cache": false
    }
  }
}
